<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DesktopDriver.Sample.DetailsWindow"
        Title="Details"
        Width="360"
        Height="200"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <TextBlock x:Name="DetailsText"
             Margin="12,44,12,12"
             TextWrapping="Wrap"
             Text="A window that draws its own title bar: the buttons that close it are the window's controls." />
</Window>
