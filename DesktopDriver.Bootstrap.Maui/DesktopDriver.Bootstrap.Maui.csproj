<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\props\Maui.props" />

  <PropertyGroup>
    <!-- Windows alone, as the backend it starts: see DesktopDriver.Maui. -->
    <TargetFrameworks>$(NetTfm)-windows10.0.19041.0</TargetFrameworks>
    <AssemblyTitle>S#.DesktopDriver.Bootstrap.Maui</AssemblyTitle>
    <Description>Turns a MAUI application into one that can be driven.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- MAUI's own types are not CLS-compliant, and every member here takes one. -->
    <DefineConstants>$(DefineConstants);CLS_DISABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MsExtensionsVer)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopDriver.Maui\DesktopDriver.Maui.csproj" />
    <ProjectReference Include="..\DesktopDriver.Host\DesktopDriver.Host.csproj" />
  </ItemGroup>

</Project>
